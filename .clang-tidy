# owning-memory is off because JUCE factory APIs (createEditor, createPluginFilter) return raw owning pointers.
Checks: 'bugprone-*,performance-*,modernize-*,-modernize-use-trailing-return-type,readability-*,-readability-magic-numbers,-readability-identifier-length,-readability-function-cognitive-complexity,cppcoreguidelines-*,-cppcoreguidelines-avoid-magic-numbers,-cppcoreguidelines-pro-bounds-constant-array-index,-cppcoreguidelines-owning-memory'
WarningsAsErrors: '*'
HeaderFilterRegex: '(engine|bank|midiexport|plugin|ui|tools)/'
