# md_embed_files(<target> <namespace> <files...>)
# Compiles the files into <target> as byte arrays and defines
# std::span<const std::string_view> <namespace>::bundledEntries().
function(md_embed_files target ns)
  set(arrays "")
  set(views "")
  set(index 0)
  foreach(file IN LISTS ARGN)
    file(READ ${file} hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND arrays "constexpr unsigned char kFile${index}[] = {${bytes}};\n")
    string(APPEND views "    {reinterpret_cast<const char*>(kFile${index}), sizeof kFile${index}},\n")
    math(EXPR index "${index} + 1")
  endforeach()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${ARGN})

  set(source "${CMAKE_CURRENT_BINARY_DIR}/${target}_embedded.cpp")
  file(CONFIGURE OUTPUT ${source} @ONLY CONTENT [[
// Generated by cmake/EmbedFiles.cmake. Do not edit.
// NOLINTBEGIN
#include <span>
#include <string_view>

namespace @ns@
{
namespace
{
@arrays@
const std::string_view kFiles[] = {
@views@};
} // namespace

std::span<const std::string_view> bundledEntries()
{
    return kFiles;
}
} // namespace @ns@
// NOLINTEND
]])
  target_sources(${target} PRIVATE ${source})
endfunction()
